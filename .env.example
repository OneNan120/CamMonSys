# Copy to .env; replace placeholders. 
NODE_ENV=development
PORT=3000
POSTGRES_USER=cammon
POSTGRES_DB=cammon
POSTGRES_PASSWORD=replace-with-a-local-password
DATABASE_URL=postgresql://cammon:replace-with-a-local-password@127.0.0.1:5433/cammon

# Authentication
# Use a random value of at least 32 characters.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
AUTH_SESSION_DURATION_SECONDS=28800

# demo users seed
DEMO_ADMIN_NAME=Demo Admin
DEMO_ADMIN_EMAIL=admin@example.com
DEMO_ADMIN_PASSWORD=your-chosen-password

DEMO_MONITOR_NAME=Demo Monitor
DEMO_MONITOR_EMAIL=monitor@example.com
DEMO_MONITOR_PASSWORD=another-chosen-password

DEMO_RESPONDER_NAME=Demo Responder
DEMO_RESPONDER_EMAIL=responder@example.com
DEMO_RESPONDER_PASSWORD=another-chosen-password

# test database
TEST_DATABASE_URL=postgresql://cammon:replace-with-a-local-password@127.0.0.1:5433/cammon_test

# LiveKit Cloud
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-api-key
LIVEKIT_API_SECRET=your-api-secret

# Camera and live-update intervals
CAMERA_HEARTBEAT_INTERVAL_SECONDS=10
CAMERA_PUBLISHING_LEASE_SECONDS=30
CAMERA_CLEANUP_INTERVAL_SECONDS=10
SSE_KEEPALIVE_INTERVAL_SECONDS=15
## Set to the exact HTTPS application origin behind a production proxy.
# APP_ORIGIN=https://camera.example.com
