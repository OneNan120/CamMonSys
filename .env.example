# Copy to .env; replace placeholders. Never commit .env.
NODE_ENV=development
PORT=3000
POSTGRES_USER=cammon
POSTGRES_DB=cammon
POSTGRES_PASSWORD=replace-with-a-local-password
DATABASE_URL=postgresql://cammon:replace-with-a-local-password@127.0.0.1:5433/cammon

# Reserved for the later authentication and live-video milestones.
JWT_SECRET=replace-with-a-random-secret
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
